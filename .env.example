# App port on the host's loopback interface.
RELAY_PORT=8787
# Public HTTPS domain when using compose.https.yaml
# RELAY_DOMAIN=relay.example.org
# Public browser origin when using your own HTTPS proxy with compose.yaml
# RELAY_ORIGIN=https://relay.example.org
# Enable only behind a trusted local HTTPS proxy that overwrites X-Real-IP
# with its client's IP. The bundled HTTPS Compose configuration enables this.
# RELAY_TRUST_PROXY_IP=true
RELAY_INTERVAL=1m
RELAY_MAX_MIB=32
# Specific private mail server addresses, if needed (CIDR, comma-separated).
# RELAY_ALLOWED_CIDRS=10.1.2.3/32
